{
  "main": "expo-router/entry",
  "packageManager": "bun@1.2.4",
  "scripts": {
    "build:docker": "docker build . --tag last-dram && docker-compose up",
    "build:ios": "eas build --platform ios",
    "build:web": "expo export --platform web && bun scripts/replace-html-paths.ts",
    "cy:component": "cypress open --component --browser chrome",
    "dev:backend": "bun --hot src/backend/server.ts",
    "dev:web": "API_URL=http://localhost:3000 expo start --web --clear",
    "dev:ios": "API_URL=http://localhost:3000 expo start --ios --clear",
    "format": "prettier --write .",
    "start:backend": "bun src/backend/server.ts",
    "submit:ios": "eas submit --platform ios --latest"
  },
  "dependencies": {
    "@clerk/clerk-expo": "2.20.0",
    "@expo/metro-runtime": "4.0.1",
    "@tanstack/react-query": "5.102.8",
    "@trpc/client": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "@trpc/server": "11.18.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "bun-types": "1.4.2",
    "drizzle-orm": "0.45.2",
    "drizzle-kit": "0.31.10",
    "eas-cli": "16.32.0",
    "expo": "52.0.49",
    "expo-router": "4.0.22",
    "expo-secure-store": "14.2.4",
    "expo-status-bar": "2.2.3",
    "expo-updates": "0.28.18",
    "pg": "8.23.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "4.14.1",
    "react-native-web": "0.21.2",
    "trpc-bun-adapter": "1.3.2",
    "typescript": "5.9.3",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@testing-library/cypress": "10.1.3",
    "@types/testing-library__cypress": "5.0.13",
    "cypress": "14.5.4",
    "husky": "9.1.7",
    "prettier": "3.9.6",
    "vite": "6.4.3"
  }
}
